{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "capstone-tauri-app",
  "version": "0.1.0",
  "identifier": "com.example.capstone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Capstone — Tauri + React 19 + Tailwind 4",
        "width": 480,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
